# Use a stable, secret value in deployed environments so encrypted credentials
# remain readable across restarts and application instances.
FORGEPILOT_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional overrides. Defaults are .data/asdp.sqlite and .data/credential.key.
# FORGEPILOT_DB_PATH=C:/path/to/asdp.sqlite
# FORGEPILOT_CREDENTIAL_KEY_PATH=C:/path/to/credential.key

# Legacy ASDP_* variables remain supported for existing deployments.
