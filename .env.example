# Use a stable, secret value in deployed environments so encrypted credentials
# remain readable across restarts and application instances.
ASDP_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional overrides. Defaults are .data/asdp.sqlite and .data/credential.key.
# ASDP_DB_PATH=C:/path/to/asdp.sqlite
# ASDP_CREDENTIAL_KEY_PATH=C:/path/to/credential.key
